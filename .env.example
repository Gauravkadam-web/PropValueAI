# PropValueAI — Root Environment Template (Sample Only)
# Copy this file to .env and supply your local configuration.
# The AI agent must never access or touch real .env files containing credentials.

# ML Inference Service (FastAPI) Configuration
PROPVALUEAI_HOST=127.0.0.1
PROPVALUEAI_PORT=8000
PROPVALUEAI_MAX_BATCH_SIZE=100
PROPVALUEAI_LOG_LEVEL=INFO

# Optional Artifact Path Overrides
PROPVALUEAI_MODEL_PATH=ml/inference/artifacts/model.joblib
PROPVALUEAI_METADATA_PATH=ml/inference/artifacts/metadata.json
