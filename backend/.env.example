# PropValueAI — Backend Environment Template (Sample Only)
# Copy this file to .env and supply your local configuration.
# The AI agent must never access or touch real .env files containing credentials.

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/propvalueai_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_local_postgres_password

# JWT Authentication
# Secret must be a secure, random string (min 256-bit / 32 characters for HMAC-SHA256)
PROPVALUEAI_JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security_12345
PROPVALUEAI_JWT_EXPIRATION_MS=86400000

# Internal Python FastAPI Inference Service URL
PROPVALUEAI_FASTAPI_BASE_URL=http://127.0.0.1:8000

# Initial Admin User Setup (Optional: Automatically created on startup if specified)
PROPVALUEAI_ADMIN_EMAIL=admin@propvalueai.local
PROPVALUEAI_ADMIN_PASSWORD=AdminSecurePassword123!
PROPVALUEAI_ADMIN_FIRST_NAME=System
PROPVALUEAI_ADMIN_LAST_NAME=Administrator

# CORS Configuration (Comma-separated allowed origins for Phase 5 frontend)
PROPVALUEAI_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
